# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Source names are deliberately generic. Connection details for any upstream
# provider live here in the environment, never in code, comments, documentation
# or the user interface.

# Primary market data application programming interface (API).
# Base URL up to and including the version path segment.
WOONG_PRIMARY_API_BASE=
# Optional bearer token, if the primary API requires one.
WOONG_PRIMARY_API_TOKEN=

# Broker connection, used for the official daily close and for full-history
# daily open/high/low/close/volume (OHLCV) bars.
#
# Setup:
#   1. Fill the fields below (market-data host, login host, key, secret,
#      user id, password, time-based one-time password secret, version header).
#   2. python -m woong.ingest.broker_auth --check
#   3. python -m woong.ingest.broker harvest-all
#
# A fresh access token is written to data/.broker_token (mode 0600, gitignored).
# Tokens reset every day at 06:00 India Standard Time (IST). Pass --clear to
# force a new login. Optional WOONG_BROKER_ACCESS_TOKEN skips file + login.
WOONG_BROKER_API_BASE=
WOONG_BROKER_LOGIN_BASE=
WOONG_BROKER_API_KEY=
WOONG_BROKER_API_SECRET=
WOONG_BROKER_USER_ID=
WOONG_BROKER_PASSWORD=
WOONG_BROKER_TOTP_SECRET=
WOONG_BROKER_ACCESS_TOKEN=
# Protocol version header name and value required by the broker HTTP API.
WOONG_BROKER_HTTP_VERSION_HEADER=
WOONG_BROKER_HTTP_VERSION=

# Hosted Postgres mirror. Empty means local only, which is the default while
# the warehouse is being built.
WOONG_POSTGRES_URL=

# Where the local store is written. Relative paths resolve from the repository
# root. This directory is gitignored.
WOONG_DATA_DIR=data
